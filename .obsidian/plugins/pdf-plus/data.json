  "defaultDisplayTextFormatIndex": 5,
  "syncDisplayTextFormat": true,
  "syncDefaultDisplayTextFormat": false,
  "copyCommands": [
    {
      "name": "Quote",
      "template": "> ({{linkWithDisplay}})\n> {{text}}\n"
    },
    {
      "name": "Link",
      "template": "{{linkWithDisplay}}"
    },
    {
      "name": "Embed",
      "template": "!{{link}}"
    },
    {
      "name": "Callout",
      "template": "> [!{{calloutType}}|{{color}}] {{linkWithDisplay}}\n> {{text}}\n"
    },
    {
      "name": "Quote in callout",
      "template": "> [!{{({\"255,212,0\":\"fact\",\"255,102,102\":\"disagree\",\"95,178,54\":\"agree\",\"46,168,229\":\"connection\",\"229,110,238\":\"question\",\"241,152,55\":\"definition\",\"102,102,102\":\"word\"}[color.replace(/\\s/g, \"\")] || color)}}] {{linkWithDisplay}}\n> > #{{({\"255,212,0\":\"fact\",\"255,102,102\":\"disagree\",\"95,178,54\":\"agree\",\"46,168,229\":\"connection\",\"229,110,238\":\"question\",\"241,152,55\":\"definition\",\"102,102,102\":\"word\"}[color.replace(/\\s/g, \"\")] || color)}} {{text}}\n> \n> "
    },
    {
      "name": "Paragraf",
      "template": "{{((value) => { try { return (function highlightTagForColor(value) { const names = ['fact', 'disagree', 'agree', 'connection', 'question', 'definition', 'word']; const rgbNames = new Map([ ['255,212,0', 'fact'], ['255,102,102', 'disagree'], ['95,178,54', 'agree'], ['46,168,229', 'connection'], ['229,110,238', 'question'], ['241,152,55', 'definition'], ['102,102,102', 'word'] ]); const raw = String(value ?? '').trim(); const name = raw.toLowerCase(); if (names.includes(name)) return '#' + name + ' '; let csv = raw; const rgb = raw.match(/^rgb\\(\\s*(.*?)\\s*\\)$/i); if (rgb) csv = rgb[1]; if (/^#[0-9a-f]{6}$/i.test(csv)) { csv = [1, 3, 5].map((offset) => parseInt(csv.slice(offset, offset + 2), 16)).join(','); } csv = csv.replace(/\\s+/g, ''); const tag = rgbNames.get(csv); if (tag) return '#' + tag + ' '; throw new Error('Culoare de verificat: ' + (raw || '(valoare goală)') + '. Setează o culoare asociată unuia dintre cele șapte taguri.'); })(value); } catch (error) { new obsidian.Notice(error.message, 10000); throw error; } })(colorName)}}{{text.replace(/\\s+/g, \" \").trim()}} {{linkWithDisplay}}"
    }
  ],
