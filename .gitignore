# Texere – what goes to GitHub.
# Everything is private by default: only the paths unlocked with "!" below are published.
# A new folder you create stays on your laptop until you add it here.
/*
!/.gitignore
!/README.md
!/LICENSE
!/Home.md
!/Fields/
!/01. Sources/
!/Support/
!/.obsidian/

# Personal folders: only the empty folders are published (each keeps a hidden .gitkeep), never the notes
!/02. Notes/
!/03. Workspace/
!/04. Export/
/02. Notes/**
/03. Workspace/**
/04. Export/**
!/02. Notes/**/
!/03. Workspace/**/
!/04. Export/**/
!/02. Notes/**/.gitkeep
!/03. Workspace/**/.gitkeep
!/04. Export/**/.gitkeep

# Never published
.DS_Store
Thumbs.db
/Support/Utilities.md
/Support/Admin/pdf-log.txt
/Support/Guides/03. Texere – Setup report.md
/Support/Guides/03. Texere – Raport configurare.md
/01. Sources/Documents/kop_towards_2023.html
/01. Sources/**/citekeylist.txt

# Obsidian: your layout and settings written on each laptop (paths, caches)
/.obsidian/workspace.json
/.obsidian/workspace-mobile.json
/.obsidian/workspaces.json
/.obsidian/plugins/texere/data.json
/.obsidian/plugins/obsidian-pandoc/data.json
/.obsidian/pdf-highlight-backups/
